[Unit]
Description=WorkOS: зеркало календарей и блоки плана (без модели)
After=network-online.target
Wants=network-online.target

[Service]
User=workos-exec
Group=workos-exec
WorkingDirectory=/opt/workos
Environment=WORKOS_ROLE=executor
Environment=HOME=/var/lib/workos-exec
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/workos/.venv/bin/python -m executors calendar --loop 900
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workos-exec /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
