[Unit]
Description=WorkOS: приём событий с Мака (А-Чат), только tailnet
After=network-online.target
Wants=network-online.target

[Service]
User=workos-reader
Group=workos-reader
WorkingDirectory=/opt/workos
Environment=WORKOS_ROLE=reader
Environment=HOME=/var/lib/workos-reader
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/workos/.venv/bin/python workctl.py ingest
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workos-reader /tmp
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
