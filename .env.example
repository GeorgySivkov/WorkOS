# Postgres. Роли БД разные для reader и executor - заводятся в шаге 0.3
PGHOST=
PGPORT=25060
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# --- только в .env.reader: токены источников, read-only скоупы ---
TRELLO_KEY=
TRELLO_TOKEN=
PLAUD_TOKEN=
GMAIL_READONLY_CREDENTIALS=
ALFA_EAS_USER=
ALFA_EAS_PASSWORD=

# --- только в .env.executor: право записи ---
GMAIL_SEND_CREDENTIALS=
TRELLO_WRITE_TOKEN=
TELEGRAM_BOT_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
